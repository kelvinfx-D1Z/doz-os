// Force Vercel to rebuild Prisma Client for Postgres
// DOZ OS — Digit One Zero Operating System
// Prisma schema (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// USERS & TEAM
// ============================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("FOUNDER") // FOUNDER, STAFF, INTERN, FREELANCER
  title     String?
  phone     String?
  address   String?
  bankName  String?
  bankAccount String?
  bankAccountName String?
  // ---- employment record (entered by the person themselves) ----
  dateOfBirth DateTime?
  startDate   DateTime?
  idNumber    String?  // national ID / NIN
  emergencyName         String?
  emergencyPhone        String?
  emergencyRelationship String?
  nextOfKinName         String?
  nextOfKinPhone        String?
  nextOfKinRelationship String?
  guarantorName    String?
  guarantorPhone   String?
  guarantorAddress String?
  // Per-person grant, set by the founder. Bank details are otherwise visible
  // only to the founder and to their own owner — this is how a future
  // accountant gets payment access without being handed a STAFF role.
  canViewBankDetails Boolean @default(false)
  avatar    String?
  capacity  Int      @default(40) // available hours/week
  isActive  Boolean  @default(true)
  password  String?  // hashed (sha256) — demo password: doz2025
  // Per-user module permissions — JSON array of ModuleId strings.
  // When set, this OVERRIDES the role-based ROLE_MODULES defaults in app-shell.tsx.
  // When null/empty, the role-based defaults are used.
  // Example: '["command","field","projects","help"]'
  permissions String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  tasksAssigned    Task[]      @relation("TaskAssignee")
  tasksCreated     Task[]      @relation("TaskCreator")
  goalsOwner       Goal[]      @relation("GoalOwner")
  projectsManaged  Project[]   @relation("ProjectManager")
  crewAssignments  CrewAssignment[]
  dailyReports     DailyReport[]
  weeklyReports    WeeklyReport[]
  approvalsGiven   Approval[]  @relation("ApprovalApprover")
  paymentsRequested PaymentRequest[] @relation("PaymentRequester")
  paymentsApproved PaymentRequest[] @relation("PaymentApprover")
  paymentsPaid     PaymentRequest[] @relation("PaymentPayer")
  activityLogs     ActivityLog[]
  sopAuthors       Sop[]
  routineLogs      RoutineLog[]
  crewAvailability CrewAvailability[]
  timeEntries      TimeEntry[]
  messagesSent     Message[] @relation("MessageSender")
  messagesReceived Message[] @relation("MessageRecipient")
  recoveryCodes    RecoveryCode[]
}

// ============================================================
// ACCOUNT RECOVERY
//
// The founder has nobody above them to reset their password. Everyone else can
// be reset from Team Management; the founder cannot, so a lost laptop or a
// forgotten password locks the owner out of their own company permanently.
//
// There is no email provider in this app, so a reset link is not available.
// Recovery codes need no infrastructure: generate a set, store them somewhere
// physical, and one of them can be exchanged for a new password.
//
// Codes are HASHED with the same salted scrypt used for passwords — a leaked
// database must not yield working recovery codes. Each is single use.
// ============================================================
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String    // scrypt$salt$hash — never the code itself
  label     String?   // "generated 2026-08-04"
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

// ============================================================
// INTERNAL MESSAGING
// Two-way direct messages between the founder and team members.
// A thread is simply every message exchanged between two users —
// there is no separate Thread row to keep in sync.
// ============================================================
model Message {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id])
  body        String
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([recipientId, readAt])
  @@index([senderId])
  @@index([createdAt])
}

// ============================================================
// STRATEGIC PLANNING
// ============================================================

model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   // ANNUAL, QUARTERLY, MONTHLY, WEEKLY
  status      String   @default("ACTIVE") // ACTIVE, ACHIEVED, MISSED, ON_HOLD
  progress    Int      @default(0) // 0-100
  ownerId     String
  owner       User     @relation("GoalOwner", fields: [ownerId], references: [id])
  parentId    String?  // cascade link
  parent      Goal?    @relation("GoalChildren", fields: [parentId], references: [id])
  children    Goal[]   @relation("GoalChildren")
  quarter     String?  // e.g. "Q1-2025"
  startDate   DateTime
  dueDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[] @relation("TaskGoal")
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("TODO") // TODO, IN_PROGRESS, DONE, BLOCKED
  priority    String   @default("MEDIUM") // URGENT, HIGH, MEDIUM, LOW
  category    String?  // STRATEGIC, OPERATIONAL, ADMIN, DISTRACTION
  assigneeId  String?
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId   String
  creator     User     @relation("TaskCreator", fields: [creatorId], references: [id])
  goalId      String?
  goal        Goal?    @relation("TaskGoal", fields: [goalId], references: [id])
  projectId   String?
  project     Project? @relation("ProjectTasks", fields: [projectId], references: [id])
  dueDate     DateTime?
  estimatedHrs Int?
  actualHrs   Int?
  isDistraction Boolean @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([assigneeId])
  @@index([creatorId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

// ============================================================
// CRM & SALES
// ============================================================

model Account {
  id          String   @id @default(cuid())
  name        String
  industry    String?
  website     String?
  isStrategic Boolean  @default(false)
  lifetimeValue Float @default(0)
  portalToken String?  @unique // for client portal access (?portal=TOKEN)
  portalActive Boolean @default(false)
  billingAddress String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts      Contact[]
  opportunities Opportunity[]
  projects      Project[]
  invoices      Invoice[]
  referralsFrom Referral[] @relation("ReferralFromAccount")
  referralsTo   Referral[] @relation("ReferralToAccount")
  paymentConfirmations PaymentConfirmation[]
  clientFeedback   ClientFeedback[]
  contracts      Contract[]
  leads         Lead[]
  quotations     Quotation[]
}

model Contact {
  id        String   @id @default(cuid())
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  name      String
  title     String?
  email     String?
  phone     String?
  isDecisionMaker Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities Opportunity[]
  followUps     FollowUp[]
  referrals     Referral[]
  leads         Lead[]
}

model Lead {
  id          String   @id @default(cuid())
  contactName String
  company     String?
  source      String   @default("REFERRAL") // REFERRAL, EXISTING_CLIENT, NETWORKING, COLD, SOCIAL
  sourceDetail String? // who referred
  serviceInterest String?
  status      String   @default("NEW") // NEW, QUALIFIED, CONVERTED, LOST
  value       Float    @default(0)
  direction   String   @default("INBOUND") // INBOUND (they asked) | OUTBOUND (we are going after them)
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  opportunityId String?
  followUps   FollowUp[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Opportunity {
  id          String   @id @default(cuid())
  name        String
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  stage       String   @default("DISCOVERY") // DISCOVERY, QUALIFIED, PROPOSAL, NEGOTIATION, WON, LOST
  value       Float    @default(0)
  probability Int      @default(20) // 0-100
  serviceType String?
  expectedClose DateTime?
  source      String   @default("REFERRAL")
  lostReason  String?
  convertedToProjectId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proposals  Proposal[]
  followUps  FollowUp[]
  activities ActivityLog[]
}

model Proposal {
  id          String   @id @default(cuid())
  opportunityId String?
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  title       String
  amount      Float
  status      String   @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED
  sentDate    DateTime?
  responseDate DateTime?
  validUntil  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FollowUp {
  id            String   @id @default(cuid())
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  contactId     String?
  contact       Contact? @relation(fields: [contactId], references: [id])
  leadId        String?
  lead          Lead?    @relation(fields: [leadId], references: [id])
  type          String   @default("CALL") // CALL, EMAIL, MEETING, WHATSAPP
  subject       String
  notes         String?
  dueDate       DateTime
  completed     Boolean  @default(false)
  completedAt   DateTime?
  assigneeId    String?  // who should follow up
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([leadId])
}

model Referral {
  id          String   @id @default(cuid())
  referrerContactId String?
  referrer    Contact? @relation(fields: [referrerContactId], references: [id])
  fromAccountId String?
  fromAccount Account? @relation("ReferralFromAccount", fields: [fromAccountId], references: [id])
  toAccountId   String?
  toAccount   Account? @relation("ReferralToAccount", fields: [toAccountId], references: [id])
  referrerName String? // free text if no contact
  value       Float    @default(0) // value of business generated
  note        String?
  createdAt   DateTime @default(now())
}

// ============================================================
// PROJECT & EVENT OPERATIONS
// ============================================================

model Project {
  id          String   @id @default(cuid())
  name        String
  code        String?  // e.g. EVT-2025-001
  serviceType String   // EVENT_PRODUCTION, VIDEO_PRODUCTION, TITLE_SEQUENCE, COLOR_GRADING, etc.
  status      String   @default("PLANNING") // PLANNING, CONFIRMED, IN_PROGRESS, COMPLETED, ON_HOLD, CANCELLED
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  managerId   String?
  manager     User?    @relation("ProjectManager", fields: [managerId], references: [id])
  eventDate   DateTime?
  venue       String?
  // Government clients withhold 5% at source, so the cash received is less
  // than the invoice total. Drives WHT on invoices for this project.
  isGovernment Boolean @default(false)
  // A Production Manager can create a project, but it does not become real
  // work until the founder approves it. Defaults to APPROVED so every existing
  // project and anything the founder creates is unaffected.
  approvalStatus String @default("APPROVED") // PENDING, APPROVED, REJECTED
  createdById String?
  approvedById String?
  approvedAt  DateTime?
  rejectionNote String?
  budget      Float    @default(0)
  revenue     Float    @default(0)
  progress    Int      @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  milestones   Milestone[]
  deliverables Deliverable[]
  crew         CrewAssignment[]
  tasks        Task[]      @relation("ProjectTasks")
  invoices     Invoice[]
  expenses     Expense[]
  budgets      Budget[]
  rfqs         Rfq[]
  pos          PurchaseOrder[]
  resources    ResourceBooking[]
  paymentRequests PaymentRequest[]
  vendorCosts    ProjectVendorCost[]
  equipment      ProjectEquipment[]
  contracts      Contract[]
  services         ProjectService[]
  eventDayLogs   EventDayLog[]
  eventDayStatus EventDayStatus?
  clientFeedback  ClientFeedback[]
  timeEntries     TimeEntry[]
  postEventReviews PostEventReview[]
  vendorReviewsFrom  VendorReview[]
  quotations   Quotation[]

  @@index([managerId])
  @@index([accountId])
  @@index([status])
  @@index([eventDate])

  // BASE while the production manager builds the cost sheet; OFFICIAL once the
  // founder has priced it and taken the project over. The stage is what locks
  // the cost sheet against further PM edits — see src/lib/pricing.ts.
  pricingStage String   @default("BASE") // BASE | OFFICIAL
  convertedToOfficialAt DateTime?
  convertedById String?
  /** Which EventTemplate seeded this project's cost sheet, for reference. */
  templateId   String?
}

model Milestone {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  title       String
  dueDate     DateTime
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, DONE, OVERDUE
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Deliverable {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  title       String
  type        String?  // VIDEO, PHOTO, LIVESTREAM, DOCUMENT
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, REVIEW, DELIVERED
  dueDate     DateTime?
  clientApproved   Boolean  @default(false)
  clientApprovedAt DateTime?
  clientApprovalNote String?
  clientRejectedAt  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CrewAssignment {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  role        String   // PRODUCTION_MANAGER, TECHNICAL_DIRECTOR, CAMERA_OP, SOUND_ENG, LIGHTING, SET_DESIGN, STAGE_MGR, EDITOR, VENDOR
  dayRate     Float    @default(0)
  status      String   @default("ASSIGNED") // ASSIGNED, CONFIRMED, DECLINED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

model ResourceBooking {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  name        String
  type        String   // CAMERA, LIGHTING, SOUND, LED_SCREEN, STAGE, GENERATOR
  quantity    Int      @default(1)
  cost        Float    @default(0)
  bookedFrom  DateTime?
  bookedTo    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// PROCUREMENT & VENDOR MANAGEMENT
// ============================================================

model Vendor {
  id          String   @id @default(cuid())
  name        String
  category    String   // EQUIPMENT, CATERING, DECOR, PRINTING, TRANSPORT, SOUND, LIGHTING, LED, STAGE, OTHER
  contactName String?
  phone       String?
  email       String?
  bankAccount String?
  rating      Int      @default(0) // 0-5
  totalSpent  Float    @default(0)
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes Quote[]
  pos    PurchaseOrder[]
  expenses Expense[]
  projectCosts ProjectVendorCost[]
  equipment    ProjectEquipment[]
  projectServices  ProjectService[]
  vendorReviews  VendorReview[]
}

model Rfq {
  id          String   @id @default(cuid())
  code        String?  // Rfq-2025-001
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  title       String
  description String?
  category    String?
  budget      Float?
  status      String   @default("OPEN") // OPEN, QUOTES_RECEIVED, PO_CREATED, CLOSED
  neededBy    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes Quote[]
}

model Quote {
  id          String   @id @default(cuid())
  rfqId       String
  rfq         Rfq      @relation(fields: [rfqId], references: [id])
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  amount      Float
  deliveryDays Int?
  notes       String?
  isRecommended Boolean @default(false)
  isApproved   Boolean @default(false)
  receivedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  code        String?  // PO-2025-001
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  quoteId     String?
  amount      Float
  description String?
  status      String   @default("DRAFT") // DRAFT, ISSUED, DELIVERED, CLOSED
  issuedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  paymentRequests PaymentRequest[]
}

model PaymentRequest {
  id           String   @id @default(cuid())
  code         String?  // PR-2025-001
  purchaseOrderId String?
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])
  amount       Float
  description  String?
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED, PAID
  // 3-way segregation of duties
  requesterId  String
  requester    User     @relation("PaymentRequester", fields: [requesterId], references: [id])
  approverId   String?
  approver     User?    @relation("PaymentApprover", fields: [approverId], references: [id])
  payerId      String?
  payer        User?    @relation("PaymentPayer", fields: [payerId], references: [id])
  requestedAt  DateTime @default(now())
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  approvals Approval[]

  @@index([projectId])
  @@index([status])
  @@index([requesterId])
  @@index([approverId])
}

model Approval {
  id          String   @id @default(cuid())
  entityType  String   // PAYMENT_REQUEST, PURCHASE_ORDER, PROPOSAL, EXPENSE
  entityId    String
  approverId  String
  approver    User     @relation("ApprovalApprover", fields: [approverId], references: [id])
  decision    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  paymentRequest PaymentRequest? @relation(fields: [paymentRequestId], references: [id])
  paymentRequestId String?
}

// ============================================================
// FINANCIAL INTELLIGENCE
// ============================================================

model Invoice {
  id          String   @id @default(cuid())
  // Unique because TWO code paths mint invoice numbers into this one
  // namespace: the Documents module and reconcileReceived() in
  // /api/doz/projects. Both now draw from the same DocumentSequence, and this
  // constraint is the database making sure they can never silently diverge
  // again — a duplicated invoice number is an audit problem.
  code        String?  @unique // INV-2025-001
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  // `amount` is the invoice TOTAL the client sees: subtotal - discount + tax.
  amount      Float
  tax         Float    @default(0) // VAT amount
  subtotal    Float    @default(0) // sum of lines, before discount and VAT
  discount    Float    @default(0)
  vatRate     Float    @default(7.5)
  // Withholding tax is DEDUCTED AT SOURCE by government clients on the pre-VAT
  // value. It is not a discount and not a debt — it is remitted to FIRS on our
  // behalf and reclaimed as a credit. The cash that arrives depends on whether
  // the client also withholds VAT: government MDAs withhold both, so cash is
  // `net - wht`; a commercial client pays the VAT across, so cash is
  // `total - wht`. See vatWithheldAtSource and src/lib/document-math.ts.
  // Without expectedCash, every government invoice reads as permanently
  // underpaid by exactly the withheld amount.
  whtRate     Float    @default(0)  // 5 for government contracts, else 0
  whtAmount   Float    @default(0)
  expectedCash Float   @default(0) // amount - whtAmount; 0 means "use amount"
  status      String   @default("DRAFT") // DRAFT, SENT, PARTIAL, PAID, OVERDUE
  amountPaid  Float    @default(0)
  issuedDate  DateTime @default(now())
  dueDate     DateTime?
  paidDate    DateTime?
  reminderCount Int    @default(0)
  lastReminderAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  detailLevel String   @default("SUMMARY")
  title       String?
  eventStart  DateTime?
  eventEnd    DateTime?
  paymentTerms String?
  // Unique so the database enforces conversion idempotency: a quotation
  // converts to exactly one invoice. The check in the convert route happens
  // outside its transaction, so two simultaneous converts could otherwise
  // create two invoices from one quotation.
  quotationId String?  @unique
  vatWithheldAtSource Boolean @default(false)
  grossUpRate Float    @default(0)
  targetNet   Float?
  // True only for the placeholder invoice reconcileReceived() mints in
  // /api/doz/projects when a project has no real (Documents-issued) invoice
  // yet, purely to give a "received" figure somewhere to land. Never set by
  // the Documents module. Once a project has a real invoice, reconcileReceived
  // stops minting these and Finance stops counting an existing one once the
  // project's real invoice goes live (non-DRAFT) - otherwise the same cash
  // is counted on both rows. Defaults false; legacy rows are backfilled by a
  // one-off data script, not by this default.
  isSynthetic Boolean @default(false)

  paymentConfirmations PaymentConfirmation[]
  lines       InvoiceLine[]
  receipts    Receipt[]

  @@index([projectId])
  @@index([accountId])
  @@index([status])
  @@index([dueDate])
}

// A client-facing invoice line. Deliberately NOT one-per-cost-line: the founder
// bundles several ProjectService cost rows into a single sellable line (e.g.
// MATERIALS + WORKMANSHIP + LIGHT STRIP -> "Stage Design & Fabrication"), and
// adds lines with no cost basis at all (professional fees).
// amount = days * quantity * unitPrice. unitPrice 0 marks a complimentary item.
model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  section     String?  // "AUDIO VISUAL", "Branding Indoor and Outdoor"
  description String
  subDescription String?
  days        Int      @default(1)
  quantity    Int      @default(1)
  unitPrice   Float    @default(0)
  amount      Float    @default(0)
  // Which cost lines this was priced from — for the margin panel.
  sourceServiceIds String? // JSON array of ProjectService ids
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

// The reusable "typical event" list. The PM hits Create Event, picks a
// template, and enables or disables lines rather than typing from scratch —
// which is how the spreadsheets were actually used: a master list reused per
// event with irrelevant rows left at zero.
model EventTemplate {
  id          String   @id @default(cuid())
  name        String   @unique // "Conference", "Exhibition", "Shoot"
  createdById String?  // who saved it; null for company-wide defaults
  description String?
  isActive    Boolean  @default(true)
  items       EventTemplateItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EventTemplateItem {
  id          String   @id @default(cuid())
  templateId  String
  template    EventTemplate @relation(fields: [templateId], references: [id])
  section     String   // EQUIPMENT RENTAL, PERSONNEL, BRANDING...
  name        String
  defaultQuantity Int  @default(1)
  defaultDays Int      @default(1)
  // Typical unit cost, as a starting point. Null where it always varies.
  defaultUnitCost Float?
  // Off by default = the line appears in the picker unticked (drone,
  // post-production, executive director — present but usually unused).
  enabledByDefault Boolean @default(true)
  sortOrder   Int      @default(0)

  // Where a template line is a catalogue service, its rates come from the
  // catalogue rather than a copy that goes stale.
  serviceItemId String?

  @@index([templateId])
}

model Expense {
  id          String   @id @default(cuid())
  projectId   String?
